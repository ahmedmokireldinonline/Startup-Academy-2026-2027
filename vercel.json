{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:static",
  "outputDirectory": "dist/public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/register", "destination": "/index.html" },
    { "source": "/programs", "destination": "/index.html" },
    { "source": "/404", "destination": "/index.html" }
  ]
}
